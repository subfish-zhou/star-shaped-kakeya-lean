/-!
# Arithmetic certificate for the frozen 32-segment witness

The lower surrogate replaces every logarithm by the shared rational bound.
All 32 cumulative payments are then exact rational expressions checked by
`norm_num`.
-/

open scoped BigOperators

namespace StarKakeyaLower
namespace Witness141

noncomputable section

/-- Row-specific first-window payment lower surrogate. -/
def lowHeadLower (j : Fin 32) : ℝ :=
  endpointWindowPaymentLower (outerRadius 0) (b j) (switch 1)

/-- Shared segment lower surrogate.  Index zero is harmless and filtered out of
all cumulative payments. -/
def lowSegmentLower (i : Fin 32) : ℝ :=
  endpointWindowPaymentLower (outerRadius i)
    (switch ⟨i.1, by omega⟩) (switch ⟨i.1 + 1, by omega⟩)

