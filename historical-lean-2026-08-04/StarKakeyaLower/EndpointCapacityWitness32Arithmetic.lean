    lowPaymentLower ⟨0, by omega⟩ = lowPaymentFormula ⟨0, by omega⟩ := by
  norm_num [lowPaymentLower, lowPaymentFormula, lowHeadLower, lowSegmentLower,
    endpointWindowPaymentLower, logRatioThreeTermUpper,
    outerRadius, b, switch, Fin.sum_univ_succ]

