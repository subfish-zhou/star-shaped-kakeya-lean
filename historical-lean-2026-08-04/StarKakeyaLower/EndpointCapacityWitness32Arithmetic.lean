/-- Actual first-window payment. -/
def lowHeadPayment (j : Fin 32) : ℝ :=
  endpointWindowPayment (outerRadius 0) (b j) (switch 1)

/-- Actual shared segment payment. -/
def lowSegmentPayment (i : Fin 32) : ℝ :=
  endpointWindowPayment (outerRadius i)
    (switch ⟨i.1, by omega⟩) (switch ⟨i.1 + 1, by omega⟩)

/-- Actual cumulative low payment for class `j`. -/
def lowPayment (j : Fin 32) : ℝ :=
  lowHeadPayment j +
    ∑ i : Fin 32, if 1 ≤ i.1 ∧ i.1 ≤ j.1 then lowSegmentPayment i else 0

private theorem lowHeadLower_le (j : Fin 32) :
    lowHeadLower j ≤ lowHeadPayment j := by
  apply endpointWindowPaymentLower_le
  · norm_num [outerRadius]
  · exact (b_pos j).le
  · have hj := b_le_eta j
    have heta : eta ≤ switch 1 := by norm_num [eta, switch]
    exact hj.trans heta

private theorem lowSegmentLower_le (i : Fin 32) :
    lowSegmentLower i ≤ lowSegmentPayment i := by
  apply endpointWindowPaymentLower_le
  · fin_cases i <;> norm_num [outerRadius]
  · fin_cases i <;> norm_num [switch]
  · fin_cases i <;> norm_num [switch]

/-- The shared rational surrogate underestimates the actual cumulative payment. -/
theorem lowPaymentFormula_le_lowPayment (j : Fin 32) :
    lowPaymentFormula j ≤ lowPayment j := by
  unfold lowPaymentFormula lowPayment
  apply add_le_add (lowHeadLower_le j)
  apply Finset.sum_le_sum
  intro i hi
  split_ifs
  · exact lowSegmentLower_le i
  · exact le_rfl

theorem lowPaymentLower_eq_formula (j : Fin 32) :
    lowPaymentLower j = lowPaymentFormula j := by
  fin_cases j
  · exact lowPaymentLower_eq_formula_row0
  · exact lowPaymentLower_eq_formula_row1
  · exact lowPaymentLower_eq_formula_row2
  · exact lowPaymentLower_eq_formula_row3
  · exact lowPaymentLower_eq_formula_row4
  · exact lowPaymentLower_eq_formula_row5
  · exact lowPaymentLower_eq_formula_row6
  · exact lowPaymentLower_eq_formula_row7
  · exact lowPaymentLower_eq_formula_row8
  · exact lowPaymentLower_eq_formula_row9
  · exact lowPaymentLower_eq_formula_row10
  · exact lowPaymentLower_eq_formula_row11
  · exact lowPaymentLower_eq_formula_row12
  · exact lowPaymentLower_eq_formula_row13
  · exact lowPaymentLower_eq_formula_row14
  · exact lowPaymentLower_eq_formula_row15
  · exact lowPaymentLower_eq_formula_row16
  · exact lowPaymentLower_eq_formula_row17
  · exact lowPaymentLower_eq_formula_row18
  · exact lowPaymentLower_eq_formula_row19
  · exact lowPaymentLower_eq_formula_row20
  · exact lowPaymentLower_eq_formula_row21
  · exact lowPaymentLower_eq_formula_row22
  · exact lowPaymentLower_eq_formula_row23
  · exact lowPaymentLower_eq_formula_row24
  · exact lowPaymentLower_eq_formula_row25
  · exact lowPaymentLower_eq_formula_row26
  · exact lowPaymentLower_eq_formula_row27
  · exact lowPaymentLower_eq_formula_row28
  · exact lowPaymentLower_eq_formula_row29
  · exact lowPaymentLower_eq_formula_row30
  · exact lowPaymentLower_eq_formula_row31

/-- Every actual frozen low payment exceeds the common coefficient. -/
theorem common_lt_lowPayment (j : Fin 32) : common < lowPayment j :=
  (common_lt_lowPaymentLower j).trans_le
    ((lowPaymentLower_eq_formula j).le.trans (lowPaymentFormula_le_lowPayment j))

