/-- Every frozen row's rational lower surrogate exceeds the common payment. -/
theorem common_lt_lowPaymentLower (j : Fin 32) :
    common < lowPaymentLower j := by
  fin_cases j <;> norm_num [lowPaymentLower, common]

/-- The analytic lower-surrogate sum before freezing it as a literal value. -/
def lowPaymentFormula (j : Fin 32) : ℝ :=
  lowHeadLower j +
    ∑ i : Fin 32, if 1 ≤ i.1 ∧ i.1 ≤ j.1 then lowSegmentLower i else 0

